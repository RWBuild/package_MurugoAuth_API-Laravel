{
  "name": "rwandabuild/murugo_api_auth",
  "description": "Package that will use Murugo auth to all 3rd party laravel projects with only API structure",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Uwe Aime Van",
      "email": "uweaime@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^7.4|^8.0",
    "guzzlehttp/guzzle": "^7.0",
    "illuminate/cache": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "RwandaBuild\\MurugoAuth\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RwandaBuild\\MurugoAuth\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "RwandaBuild\\MurugoAuth\\MurugoAuthServiceProvider"
      ],
      "aliases": {
        "MurugoAuth": "RwandaBuild\\MurugoAuth\\Facades\\MurugoAuth"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "require-dev": {
    "orchestra/testbench": "^10.12",
    "phpunit/phpunit": "^11.5"
  }
}
